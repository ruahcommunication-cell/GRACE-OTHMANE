---
import Site from "../layouts/Site.astro"
import ArrowLink from "../components/ArrowLink.astro"
---
<Site title="Message envoyé — Grace Othmane | ruah studio" description="Merci, votre message est bien arrivé." noindex>
    <section class="nf">
        <div class="inner">
            <h1 class="t-display">Message envoyé.</h1>
            <p class="t-lead lede">Merci ! Je reviens vers vous personnellement, très vite.</p>
            <ArrowLink href="/" label="Retour à l’accueil" />
        </div>
    </section>
</Site>
<style>
    .nf { width: 100%; max-width: 1600px; margin: 0 auto; padding: 160px var(--gutter) 200px; }
    .inner { display: flex; flex-direction: column; align-items: flex-start; gap: 36px; }
    .lede { max-width: 560px; }
</style>
