---
interface Props { label: string }
const { label } = Astro.props
---
<button type="submit" class="sb" data-label={label}><span class="t-label lbl">{label}</span><span class="t-label code">ENV-01</span></button>
<style>
    .sb { width: 360px; max-width: 100%; height: 56px; padding: 0 24px; border: 0; background: var(--accent); display: flex; align-items: center; justify-content: space-between; cursor: pointer; transition: background-color .3s var(--ease); }
    .sb .t-label { color: var(--on-accent); }
    .sb:hover { background: var(--high); }
    .sb[data-state="pending"] { cursor: progress; }
    .sb[data-state="success"] { background: var(--signal); }
    .sb[data-state="error"] { background: var(--high); }
</style>
