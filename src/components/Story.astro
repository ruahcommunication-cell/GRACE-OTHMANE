---
// Composant Framer « Story (Origin Scrub) » + override withOriginScrub
const stops = ["Paris", "France", "À distance", "Disponible"]
---
<section class="origin" data-name="Origin">
    <h2 class="sr-only">Origine</h2>
    <div class="stage">
        <div class="col">
            <div class="head">
                <p class="t-mono accent">//</p>
                <p class="t-mono">Origine</p>
                <p class="t-mono c-low" data-name="Counter">000%</p>
            </div>
            <div class="gap"></div>
            <div class="statement" data-name="Statement">
                <p class="t-manifesto">Ma conviction : une marque doit marquer les esprits au premier regard. Si elle a besoin d’un paragraphe pour s’expliquer, <em class="hot">le design n’est pas fini.</em> Chez ruah studio, je vous accompagne en direct, <em class="hot">sans intermédiaire,</em> du premier croquis aux fichiers prêts à l’emploi.</p>
            </div>
            <div class="gap"></div>
            <div class="progress">
                <div class="line"><div class="pfill" data-name="Progress Fill"></div></div>
                <div class="stops" data-name="Stops">
                    {stops.map((s, i) => (
                        <div class="stop" data-name="Stop">
                            <span class="d"><span class="on" data-name="Dot On" style={i === 0 ? "" : "opacity:0"}></span></span>
                            <p class="t-mono" style={i === 0 ? "" : "color:var(--outline)"}>{s}</p>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { originScrub } from "../fx/native"
    document.addEventListener("astro:page-load", () =>
        document.querySelectorAll<HTMLElement>('[data-name="Origin"]').forEach((el) => {
            if (el.dataset.fxInit) return
            el.dataset.fxInit = "1"
            originScrub(el)
        })
    )
</script>

<style>
    .origin { position: relative; width: 100%; height: 180vh; }
    .stage { position: sticky; top: 0; height: 100vh; width: 100%; overflow: clip; background: var(--bg); display: flex; padding: 0 6%; }
    .col { width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
    .head { display: flex; align-items: center; gap: 16px; }
    .gap { height: 6%; flex-shrink: 0; }
    .statement { width: 100%; max-width: 1180px; }
    .statement .t-manifesto { font-size: clamp(30px, 4.4vw, 68px); }
    .hot { font-style: italic; color: var(--accent); }
    .progress { width: 100%; max-width: 1180px; display: flex; flex-direction: column; gap: 14px; }
    .line { height: 1px; background: var(--line); width: 100%; }
    .pfill { height: 100%; background: var(--accent); box-shadow: 0 0 12px 0 var(--accent); transform: scaleX(0); transform-origin: left; }
    .stops { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; width: 100%; }
    .stop { display: flex; align-items: center; gap: 8px; }
    .d { width: 7px; height: 7px; border-radius: 7px; border: 1px solid var(--accent); display: block; }
    .on { display: block; width: 100%; height: 100%; border-radius: 7px; background: var(--accent); box-shadow: 0 0 10px 0 var(--accent); }
    @media (max-width: 809.98px) {
        .origin { height: 150vh; }
        .stops { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 14px; }
    }
</style>
